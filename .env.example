# =============================================================================
# .env.example — قيم توضيحية فقط. انسخه إلى .env واملأ القيم. لا ترفع .env إلى Git.
# =============================================================================

# ---- قيم عامة (تُنسخ إلى js/config.js عبر: node scripts/configure.mjs) ----
# من Supabase Dashboard → Project Settings → API
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# المفتاح العام فقط (anon أو publishable). ⚠️ ليس service_role ولا sb_secret_
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# رابط الموقع بعد النشر (اختياري، يُستخدم في رسالة واتساب وروابط الدعوات)
PUBLIC_SITE_URL=https://your-domain.example/
# رقم واتساب اختياري بصيغة دولية بدون + (اتركه فارغًا ليختار المستخدم جهة الاتصال)
PUBLIC_WHATSAPP_NUMBER=

# ---- أسرار الـ Edge Function (تُضبط عبر: supabase secrets set --env-file .env) ----
# سلسلة عشوائية طويلة لتجزئة عناوين IP قبل تخزينها (مثال للتوليد: openssl rand -hex 32)
RSVP_IP_SALT=replace-with-a-long-random-secret
# النطاقات المسموح لها باستدعاء الدالة، مفصولة بفواصل
ALLOWED_ORIGINS=https://your-domain.example,https://www.your-domain.example
# الحد الأقصى لإرسالات RSVP لكل IP خلال 10 دقائق
RSVP_SUBMIT_LIMIT=10

# ملاحظة: SUPABASE_URL و SUPABASE_SERVICE_ROLE_KEY يوفرهما Supabase تلقائيًا
# داخل Edge Functions. لا تضع مفتاح service_role في هذا المشروع إطلاقًا.
